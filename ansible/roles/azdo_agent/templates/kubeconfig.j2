{{ ansible_managed | comment }}
# The cluster stanza is copied from the break-glass kubeconfig 30-talos wrote to
# Key Vault, so the endpoint and CA cannot drift from what Talos issued. Only
# the credential differs: this one is the azdo-deployer ServiceAccount, which
# can write to the dev namespace family and nothing else
# (documentation/infrastructure/azdo_agents.md).
apiVersion: v1
kind: Config
clusters:
  - name: homelab
    cluster:
      server: {{ azdo_cluster.server }}
      certificate-authority-data: {{ azdo_cluster['certificate-authority-data'] }}
users:
  - name: azdo-deployer
    user:
      token: {{ azdo_sa_token }}
contexts:
  - name: azdo-deployer@homelab
    context:
      cluster: homelab
      user: azdo-deployer
      namespace: {{ azdo_agent_parent_namespace }}
current-context: azdo-deployer@homelab
